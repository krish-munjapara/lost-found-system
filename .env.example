# Guardian-Link Environment Variables
# Copy this file to .env and fill in your actual values

# Database
MONGO_URI=mongodb://localhost:27017
DB_NAME=guardian_link

# Security / JWT
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
EMAIL_VERIFY_EXPIRE_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Uploads
MAX_UPLOAD_SIZE_MB=10

# Cloudinary (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (optional - logs to console if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI Model
FACE_MODEL_NAME=ArcFace
DETECTOR_BACKEND=retinaface
MATCH_THRESHOLD=50.0
TOP_MATCH_LIMIT=5
AGE_TOLERANCE=2
LOCATION_RADIUS=25.0
HIGH_MATCH_THRESHOLD=90.0
MEDIUM_MATCH_THRESHOLD=75.0
LOW_MATCH_THRESHOLD=60.0

# Default Admin Account
DEFAULT_ADMIN_EMAIL=admin@guardianlink.com
DEFAULT_ADMIN_PASSWORD=1234
DEFAULT_ADMIN_NAME=System Admin

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_ENABLED=true

# SMS Provider for OTP Verification
SMS_PROVIDER=mock  # Options: twilio, mock
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=your_sender_id
